  /*
   * Existing Proposal Information API
   *
   * DO NOT CHANGE THIS
   */
  fetchDetail(formCode: string): void {

    this.loading = true;
    this.error = false;

    this.pns
      .getEmployeeStatusList()
      .subscribe({

        next: (list: any[]) => {

          list = list || [];

          const matches =
            list.filter(
              (row: any) =>
                this.getFormCode(row) === formCode
            );

          console.log(
            'PROPOSAL DETAIL MATCHES:',
            matches
          );

          if (!matches.length) {

            this.error = true;
            this.loading = false;

            return;
          }

          this.detail =
            this.mapDetail(matches[0]);

          this.loading = false;
        },

        error: (err: any) => {

          console.error(
            'NPI Proposal detail error:',
            err
          );

          this.error = true;
          this.loading = false;
        }
      });
  }


  /*
   * Step title
   */
  private stepTitle(
    stepId: number,
    routeOrder: number,
    isLast: boolean
  ): string {

    if (this.STEP_TITLES[stepId]) {

      return this.STEP_TITLES[stepId];

    }

    if (isLast) {

      return 'Closed';

    }

    if (
      routeOrder >= 1 &&
      routeOrder - 1 < this.ROUTE_NAMES.length
    ) {

      return this.ROUTE_NAMES[
        routeOrder - 1
      ];

    }

    return `Step ${stepId}`;
  }


  /*
   * Merge multiple users
   * under same step
   */
  private mapMergedWorkStep(
    rows: any[],
    isLast: boolean
  ): WorkStep {

    const firstRow =
      rows[0];

    const stepId =
      Number(
        this.getFirstValue(
          firstRow,
          [
            'STEP_ID',
            'StepId'
          ],
          0
        )
      );

    const routeOrder =
      Number(
        this.getFirstValue(
          firstRow,
          [
            'ROUTE_ORDER',
            'RouteOrder'
          ],
          -1
        )
      );

    const title =
      this.stepTitle(
        stepId,
        routeOrder,
        isLast
      );

    const isCreatorStep =
      stepId === 0 ||
      routeOrder === 1 ||
      title === 'Create Form';

    const isClosedStep =
      isLast ||
      title === 'Closed';


    /*
     * Finished row
     */
    const finishedRow =
      rows.find(
        r =>
          Number(
            this.getFirstValue(
              r,
              [
                'IS_FINISHED',
                'IsFinished'
              ],
              0
            )
          ) === 1
      );


    /*
     * Rejected row
     */
    const rejectedRow =
      rows.find(
        r =>
          Number(
            this.getFirstValue(
              r,
              [
                'IS_FINISHED',
                'IsFinished'
              ],
              0
            )
          ) === 2
      );


    const activeRow =
      finishedRow ||
      rejectedRow ||
      firstRow;


    const isFinished =
      Number(
        this.getFirstValue(
          activeRow,
          [
            'IS_FINISHED',
            'IsFinished'
          ],
          0
        )
      );


    /*
     * Status
     */
    let statusType:
      WorkStepStatusType;

    let status =
      String(
        this.getFirstValue(
          activeRow,
          [
            'STATUS',
            'Status',
            'ACTION',
            'Action',
            'DECISION',
            'Decision',
            'RESULT',
            'Result'
          ],
          ''
        )
      ).trim();


    if (isFinished === 1) {

      statusType = 'done';

      if (!status) {
        status = 'Approved';
      }

    } else if (isFinished === 2) {

      statusType = 'rejected';

      if (!status) {
        status = 'Rejected';
      }

    } else {

      statusType = 'pending';

      if (!status) {
        status = 'Pending';
      }
    }


    /*
     * Employee names
     */
    const empNames: string[] = [];


    if (
      statusType === 'done' ||
      statusType === 'rejected'
    ) {

      const signedEmp =
        String(
          this.getFirstValue(
            activeRow,
            [
              'OPT_EMP_NAME',
              'EmpName',
              'UserName',
              'USER_NAME',
              'SignerName',
              'SIGNER_NAME'
            ],
            ''
          )
        ).trim();

      if (signedEmp) {

        empNames.push(
          signedEmp
        );

      }

    } else {

      rows.forEach(
        r => {

          const name =
            String(
              this.getFirstValue(
                r,
                [
                  'OPT_EMP_NAME',
                  'EmpName',
                  'UserName',
                  'USER_NAME',
                  'SignerName',
                  'SIGNER_NAME'
                ],
                ''
              )
            ).trim();

          if (
            name &&
            !empNames.includes(name)
          ) {

            empNames.push(name);

          }

        }
      );
    }


    const OPT_EMP_NAME =
      empNames.join(' / ');


    /*
     * Reason / Remarks
     */
    let REASON = '';


    if (
      !isCreatorStep &&
      !isClosedStep
    ) {

      for (const r of rows) {

        const res =
          String(
            this.getFirstValue(
              r,
              [
                'REASON',
                'Reason',
                'REMARK',
                'Remark',
                'OPT_CONTENT',
                'OptContent',
                'OPT_REMARK',
                'COMMENT',
                'Comment',
                'COMMENTS',
                'Comments',
                'AUDIT_REMARK',
                'AuditRemark',
                'FLOW_REMARK',
                'FlowRemark',
                'SIGN_REMARK',
                'SignRemark',
                'CHECK_REMARK',
                'CheckRemark',
                'NOTE',
                'Note'
              ],
              ''
            )
          ).trim();

        if (res) {

          REASON = res;

          break;

        }
      }
    }


    /*
     * Date
     */
    const rawLastEditDt =
      this.getFirstValue(
        activeRow,
        [
          'LAST_EDIT_DT',
          'LastEditDt',
          'LAST_EDIT_DATE',
          'CREATE_DT',
          'CreateDt'
        ],
        ''
      );


    const formattedDate =
      (
        statusType === 'done' ||
        statusType === 'rejected'
      )
        ? this.formatDisplayDate(
            rawLastEditDt
          )
        : '';


    return {

      stepId,

      title,

      OPT_EMP_NAME,

      status,

      statusType,

      REASON,

      LAST_EDIT_DT:
        formattedDate
    };
  }


  /*
   * ==========================================================
   * NEW WORK DETAIL FLOW
   * ==========================================================
   *
   * OLD:
   * Angular
   *   ↓
   * Node.js :5665
   *   ↓
   * /api/proposals
   *
   * NEW:
   * Angular
   *   ↓
   * PublicNetService
   *   ↓
   * GetFormSignFlowDetail_Oracle
   *   ↓
   * Work Details
   */
  fetchWorkDetail(
    formCode: string
  ): void {

    this.stepsLoading = true;
    this.stepsError = false;


    /*
     * Get proposal information first.
     *
     * We need Form ID and Employee No
     * for Sign Flow API.
     */
    this.pns
      .getEmployeeStatusList()
      .subscribe({

        next: (list: any[]) => {

          list = list || [];


          /*
           * Find current Form Code
           */
          const row =
            list.find(
              (item: any) =>
                this.getFormCode(item) === formCode
            );


          console.log(
            'WORK DETAIL - PROPOSAL ROW:',
            row
          );


          if (!row) {

            console.error(
              'WORK DETAIL - Form not found:',
              formCode
            );

            this.stepsError = true;
            this.stepsLoading = false;

            return;
          }


          /*
           * Get Form ID
           *
           * IMPORTANT:
           * We are checking multiple possible
           * field names because API response
           * field name may vary.
           */
          const formId =
            String(
              this.getFirstValue(
                row,
                [
                  'FORM_ID',
                  'FormID',
                  'FormId',
                  'strFormID',
                  'formId',
                  'ID',
                  'Id'
                ],
                ''
              )
            ).trim();


          /*
           * Get Employee Number
           */
          const empNo =
            String(
              this.getFirstValue(
                row,
                [
                  'EMP_ID',
                  'EmpId',
                  'EmpNo',
                  'EMP_NO',
                  'strEmpNo'
                ],
                ''
              )
            ).trim();


          console.log(
            'WORK DETAIL - Form ID:',
            formId
          );

          console.log(
            'WORK DETAIL - Form Code:',
            formCode
          );

          console.log(
            'WORK DETAIL - Emp No:',
            empNo
          );


          /*
           * Form ID is mandatory
           */
          if (!formId) {

            console.error(
              'WORK DETAIL - Form ID is missing.'
            );

            console.error(
              'WORK DETAIL - Full proposal row:',
              row
            );

            this.stepsError = true;
            this.stepsLoading = false;

            return;
          }


          /*
           * ==================================================
           * DIRECT SIGN FLOW API
           * ==================================================
           */
          this.pns
            .getFormSignFlowDetail_Oracle(
              formId,
              formCode,
              empNo
            )
            .subscribe({

              next: (
                rows: any[]
              ) => {

                console.log(
                  'WORK DETAIL - SIGN FLOW ROWS:',
                  rows
                );


                const formRows:
                  any[] = rows || [];


                /*
                 * No data
                 */
                if (
                  !formRows.length
                ) {

                  console.warn(
                    'WORK DETAIL - No sign flow data returned.'
                  );

                  this.workSteps = [];

                  this.stepsError = true;
                  this.stepsLoading = false;

                  return;
                }


                /*
                 * Sort by ROUTE_ORDER
                 */
                formRows.sort(
                  (
                    a: any,
                    b: any
                  ) =>
                    Number(
                      this.getFirstValue(
                        a,
                        [
                          'ROUTE_ORDER',
                          'RouteOrder'
                        ],
                        0
                      )
                    ) -
                    Number(
                      this.getFirstValue(
                        b,
                        [
                          'ROUTE_ORDER',
                          'RouteOrder'
                        ],
                        0
                      )
                    )
                );


                /*
                 * Group rows by
                 *
                 * ROUTE_ORDER + STEP_ID
                 *
                 * This merges multiple users
                 * belonging to same step.
                 */
                const stepGroup