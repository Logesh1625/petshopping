fetchWorkDetail(formCode: string): void {
  this.stepsLoading = true;
  this.stepsError = false;

  console.log('WORK DETAIL - Form ID:', '10056');
  console.log('WORK DETAIL - Form Code:', formCode);

  const empNo = '';

  console.log('FINAL SIGN FLOW INPUT:', {
    formId: '10056',
    formCode: formCode,
    empNo: empNo
  });

  this.pns.getFormSignFlowDetail_Oracle(
    '10056',
    formCode,
    empNo
  ).subscribe({
    next: (rows: any[]) => {

      console.log('SIGN FLOW FINAL ROWS:', rows);
      console.log('SIGN FLOW IS ARRAY:', Array.isArray(rows));
      console.log('SIGN FLOW LENGTH:', rows ? rows.length : 0);

      if (!rows || !rows.length) {
        console.warn('WORK DETAIL - No sign flow data returned.');
        this.workSteps = [];
        this.stepsLoading = false;
        this.stepsError = false;
        return;
      }

      this.workSteps = rows.map((r: any, index: number) => {

        const desc = String(r.ROUTE_DESC || '');
        const match = desc.match(/^(.*?)\((.*)\)$/);

        let title = desc;
        let empName = '';

        if (match) {
          title = match[1].trim();
          empName = match[2].trim();
        }

        const flag = String(r.ROUTE_FLAG || '');

        let statusType: WorkStepStatusType = 'pending';
        let status = 'Pending';

        if (flag === '0') {
          statusType = 'done';
          status = 'Approved';
        } else if (flag === '1') {
          statusType = 'pending';
          status = 'In Progress';
        } else if (flag === '2') {
          statusType = 'pending';
          status = 'Waiting';
        } else if (flag === '3') {
          statusType = 'rejected';
          status = 'Rejected';
        }

        return {
          stepId: index,
          title: title,
          OPT_EMP_NAME: empName,
          status: status,
          statusType: statusType,
          LAST_EDIT_DT: r.OPT_TIME ? this.formatDisplayDate(r.OPT_TIME) : '',
          REASON: r.OPT_EXPLAIN && r.OPT_EXPLAIN !== 'null'
            ? String(r.OPT_EXPLAIN)
            : ''
        };
      });

      this.stepsLoading = false;
      this.stepsError = false;

      console.log('WORK DETAIL - MAPPED STEPS:', this.workSteps);
    },

    error: (err: any) => {
      console.error('SIGN FLOW ERROR:', err);
      this.workSteps = [];
      this.stepsLoading = false;
      this.stepsError = true;
    }
  });
}