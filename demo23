  // ============================================================
  // FETCH APPLICATION / NPI PROPOSAL DETAIL
  // EXISTING API
  // ============================================================

  fetchDetail(formCode: string): void {

    this.loading = true;
    this.error = false;

    this.pns.getEmployeeStatusList().subscribe({

      next: (list: any[]) => {

        list = list || [];

        const matches =
          list.filter(
            (row: any) =>
              this.getFormCode(row) === formCode
          );

        console.log(
          'PROPOSAL DETAIL MATCHES:',
          matches
        );

        if (!matches.length) {

          this.error = true;
          this.loading = false;

          return;
        }

        this.detail =
          this.mapDetail(matches[0]);

        this.loading = false;
      },

      error: (err: any) => {

        console.error(
          'NPI Proposal detail error:',
          err
        );

        this.error = true;
        this.loading = false;
      }
    });
  }

  // ============================================================
  // PARSE ROUTE DESCRIPTION
  //
  // Example:
  //
  // "First Level(HH0000010 JEEVA)"
  //
  // becomes:
  //
  // title = "First Level"
  // employee = "JEEVA"
  // ============================================================

  private parseRouteDesc(
    desc: string
  ): {
    title: string;
    empNames: string[];
  } {

    const value =
      String(desc || '').trim();

    if (!value) {

      return {
        title: '',
        empNames: []
      };
    }

    const match =
      value.match(/^(.*?)\((.*)\)$/);

    if (!match) {

      return {
        title: value,
        empNames: []
      };
    }

    const title =
      match[1].trim();

    const inside =
      match[2].trim();

    if (!inside) {

      return {
        title: title,
        empNames: []
      };
    }

    const empNames =
      inside
        .split(',')
        .map((part: string) => {

          const p =
            part.trim();

          /*
           * Example:
           * HH0000010 JEEVA
           *
           * Remove employee number
           * and keep name.
           */

          const nameMatch =
            p.match(/^(\S+)\s+(.*)$/);

          if (nameMatch) {
            return nameMatch[2].trim();
          }

          return p;

        })
        .filter(
          (name: string) => !!name
        );

    return {
      title: title,
      empNames: empNames
    };
  }

  // ============================================================
  // MAP NEW SIGN FLOW API RESPONSE
  //
  // API fields:
  //
  // ROUTE_DESC
  // ROUTE_FLAG
  // OPT_TIME
  // OPT_EXPLAIN
  // strResult
  // ============================================================

  private mapGatewayRouteToWorkSteps(
    routes: any[]
  ): WorkStep[] {

    return (routes || []).map(
      (r: any, index: number) => {

        const parsed =
          this.parseRouteDesc(
            r.ROUTE_DESC
          );

        const flag =
          String(
            this.getFirstValue(
              r,
              [
                'ROUTE_FLAG',
                'RouteFlag'
              ],
              ''
            )
          );

        let statusType:
          WorkStepStatusType;

        let status: string;

        switch (flag) {

          // Completed
          case '0':

            statusType = 'done';
            status = 'Approved';

            break;

          // Current / processing
          case '1':

            statusType = 'pending';
            status = 'In Progress';

            break;

          // Waiting
          case '2':

            statusType = 'pending';
            status = 'Waiting';

            break;

          // Rejected
          case '3':

            statusType = 'rejected';
            status = 'Rejected';

            break;

          default:

            statusType = 'pending';
            status = 'Pending';

            break;
        }

        const optTime =
          this.getFirstValue(
            r,
            [
              'OPT_TIME',
              'OptTime'
            ],
            ''
          );

        const optExplain =
          this.getFirstValue(
            r,
            [
              'OPT_EXPLAIN',
              'OptExplain'
            ],
            ''
          );

        let reason = '';

        if (
          optExplain !== null &&
          optExplain !== undefined &&
          String(optExplain).trim() !== '' &&
          String(optExplain).toLowerCase() !== 'null'
        ) {

          reason =
            String(optExplain).trim();
        }

        return {

          stepId: index,

          title:
            parsed.title,

          OPT_EMP_NAME:
            parsed.empNames.join(' / '),

          status:
            status,

          statusType:
            statusType,

          LAST_EDIT_DT:
            optTime
              ? this.formatDisplayDate(optTime)
              : '',

          REASON:
            reason
        };
      }
    );
  }

  // ============================================================
  // FETCH WORK DETAIL
  //
  // IMPORTANT:
  //
  // Form ID  = 10056
  // Form Code = clicked form code
  // Emp No    = EMPTY
  //
  // NO NODE.JS PORT
  // ============================================================

  fetchWorkDetail(formCode: string): void {

    this.stepsLoading = true;
    this.stepsError = false;

    const formId =
      this.FORM_ID;

    const empNo =
      '';

    console.log(
      'WORK DETAIL - Form ID:',
      formId
    );

    console.log(
      'WORK DETAIL - Form Code:',
      formCode
    );

    console.log(
      'WORK DETAIL - Emp No:',
      empNo
    );

    const finalInput = {

      formId: formId,

      formCode: formCode,

      empNo: empNo
    };

    console.log(
      'FINAL SIGN FLOW INPUT:',
      finalInput
    );

    /*
     * Direct call to IWX Sign Flow API.
     *
     * No Node.js backend port.
     */

    this.pns
      .getFormSignFlowDetail_Oracle(
        formId,
        formCode,
        empNo
      )
      .subscribe({

        next: (rows: any[]) => {

          console.log(
            'SIGN FLOW FINAL ROWS:',
            rows
          );

          console.log(
            'SIGN FLOW RESPONSE TYPE:',
            typeof rows
          );

          console.log(
            'SIGN FLOW IS ARRAY:',
            Array.isArray(rows)
          );

          console.log(
            'SIGN FLOW ARRAY LENGTH:',
            rows ? rows.length : 0
          );

          if (
            !rows ||
            !rows.length
          ) {

            console.warn(
              'WORK DETAIL - No sign flow data returned.'
            );

            this.workSteps = [];

            this.stepsError = false;

            this.stepsLoading = false;

            return;
          }

          /*
           * New API response directly contains
           * ROUTE_DESC / ROUTE_FLAG / OPT_TIME etc.
           */

          this.workSteps =
            this.mapGatewayRouteToWorkSteps(
              rows
            );

          console.log(
            'WORK DETAIL - MAPPED STEPS:',
            this.workSteps
          );

          this.stepsLoading = false;
        },

        error: (err: any) => {

          console.error(
            'WORK DETAIL - Sign flow error:',
            err
          );

          this.workSteps = [];

          this.stepsError = true;

          this.stepsLoading = false;
        }
      });
  }

